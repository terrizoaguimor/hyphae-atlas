# Copy this file to .env and fill in the values.
# Never commit the real .env file or expose these secrets to client-side code.

# Model provider: xai | openai | anthropic | openai-compatible
MODEL_PROVIDER=xai

# xAI (required only when MODEL_PROVIDER=xai)
# Create or manage keys at https://console.x.ai/
XAI_API_KEY=
XAI_MODEL=grok-4.6

# OpenAI (required only when MODEL_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic (required only when MODEL_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Any HTTPS OpenAI-compatible Chat Completions endpoint
# Required only when MODEL_PROVIDER=openai-compatible.
MODEL_API_KEY=
MODEL_NAME=
MODEL_BASE_URL=

# Sanity project
# Project ID and dataset name are not secrets.
SANITY_PROJECT_ID=v2ulbd4b
SANITY_DATASET=production
# Pin the Sanity API behavior to a date.
SANITY_API_VERSION=2026-09-18

# Dedicated project Editor token used only by the offline importer.
# Never configure this token in the deployed web application.
SANITY_WRITE_TOKEN=
# Dedicated Deploy Studio token used only by schema/Studio deployment commands.
SANITY_DEPLOY_TOKEN=
# Dedicated project Viewer token used by the deployed Evidence Resolver.
SANITY_READ_TOKEN=

# Sanity Context MCP
# Use an organization API token with the Context Viewer permission.
SANITY_CONTEXT_TOKEN=
SANITY_CONTEXT_MCP_URL=

# Hyphae corpus source (the public repository checked out next to this project)
HYPHAE_SOURCE_PATH=../hyphae

# Local application
APP_URL=http://localhost:3000
PORT=3000
