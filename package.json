{
  "name": "hyphae-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "A model-agnostic, version-aware evidence agent for Hyphae powered by Sanity Context.",
  "license": "Apache-2.0",
  "author": "Mario Gutierrez",
  "repository": {
    "type": "git",
    "url": "https://github.com/terrizoaguimor/hyphae-atlas.git"
  },
  "homepage": "https://atlas.terrizoaguimor.dev",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "studio": "sanity dev",
    "schema:deploy": "sanity schema deploy",
    "corpus:dry": "tsx scripts/import-hyphae.ts --dry-run",
    "corpus:import": "tsx scripts/import-hyphae.ts",
    "corpus:verify": "tsx scripts/verify-corpus.ts",
    "context:smoke": "tsx scripts/context-smoke.ts",
    "replays:capture": "tsx scripts/capture-replays.ts",
    "security:smoke": "tsx scripts/security-smoke.ts",
    "cancellation:smoke": "tsx scripts/cancellation-smoke.ts",
    "providers:smoke": "tsx scripts/provider-smoke.ts",
    "opennext:build": "opennextjs-cloudflare build",
    "build:cloudflare": "node scripts/cloudflare-safe-deploy.mjs",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "node scripts/cloudflare-safe-deploy.mjs --deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "evaluate": "tsx evaluation/run.ts",
    "evaluate:ablation": "tsx evaluation/ablation.ts",
    "evaluate:ablation:verify": "tsx evaluation/verify-ablation.ts",
    "evaluate:ablation:promote": "tsx evaluation/promote-ablation.ts",
    "demo:policy:smoke": "node scripts/judge-request-policy-smoke.mjs",
    "demo:record": "node scripts/record-judge.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@sanity/client": "8.6.2",
    "dotenv": "18.0.0",
    "gsap": "3.15.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "playwright-core": "1.63.0",
    "sanity": "5.31.2",
    "styled-components": "6.5.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "wrangler": "4.135.0"
  }
}
